# ─────────────────────────────────────────────────────────────
# EDITFLOW CRM — Variáveis de ambiente
#
# LOCAL: copie para `.env` e preencha.
# VERCEL: cadastre cada uma em Project → Settings → Environment Variables
#         (marque Production E Preview). NÃO suba o arquivo .env.
# ─────────────────────────────────────────────────────────────

# ─── Banco de dados (PostgreSQL) ─────────────────────────────
# Conexão usada pela aplicação em runtime.
#   • Local ...........: postgresql://USUARIO:SENHA@127.0.0.1:5432/editflow?schema=public
#   • Supabase ........: use o "Connection pooling" (porta 6543) + ?pgbouncer=true&connection_limit=1
#   • Neon / Vercel PG : use o URL padrão (o mesmo do DIRECT_URL)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/editflow?schema=public"

# Conexão DIRETA (sem pooler) — usada por `prisma migrate deploy` no build.
#   • Supabase ........: "Direct connection" (porta 5432)
#   • Neon / Vercel PG : o mesmo valor do DATABASE_URL
#   • Local ...........: o mesmo valor do DATABASE_URL
# OBRIGATÓRIA (o schema referencia env("DIRECT_URL")).
DIRECT_URL="postgresql://USUARIO:SENHA@HOST:5432/editflow?schema=public"

# ─── Auth.js / NextAuth ──────────────────────────────────────
# Segredo de assinatura da sessão. Gere com:  openssl rand -base64 32
AUTH_SECRET="troque-por-uma-string-aleatoria-de-32-bytes"

# Confia no host do ambiente (Vercel/Render). Deixe "true".
AUTH_TRUST_HOST="true"

# URL pública da aplicação.
#   • Local ..: http://localhost:3000
#   • Vercel .: https://SEU-PROJETO.vercel.app  (ou o domínio custom)
NEXTAUTH_URL="http://localhost:3000"

# ─── Seed (opcional — só para popular dados de demonstração) ──
SEED_USER_EMAIL="editor@editflow.dev"
SEED_USER_PASSWORD="editflow123"
SEED_USER_NAME="Editor Demo"
